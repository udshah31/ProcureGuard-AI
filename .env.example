# ── ProcureGuard AI — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your values.
#
# Pick ONE provider and set its key. All three have a free option:
#   groq    — free tier, fast        https://console.groq.com
#   gemini  — free tier              https://aistudio.google.com/apikey
#   ollama  — local, no key needed   https://ollama.com/download

# ── Provider selection ────────────────────────────────────────────────────────
# Leave LLM_PROVIDER blank to auto-detect from whichever key is set.
LLM_PROVIDER=gemini
# LLM_MODEL=                       # overrides the provider default

# ── Provider keys (only the one you use is required) ─────────────────────────
GOOGLE_API_KEY=
GROQ_API_KEY=

# ── API auth ──────────────────────────────────────────────────────────────────
# Comma-separated key:role[:identity] entries. Callers send their key in the
# X-API-Key header; the caller's role AND identity are resolved from this
# mapping server-side — neither is trusted from the request body anymore.
# identity is what gets recorded as approved_by on PO approvals (and other
# actor fields); omit it to default to "<role>@procureguard.local". Roles:
# requester, approver, finance, admin. These demo values match
# ui/index.html's DEMO_KEYS — replace both with real, secret keys before
# deploying anywhere beyond local dev.
API_KEYS=demo-requester-key:requester:requester@company.com,demo-approver-key:approver:approver@company.com,demo-finance-key:finance:finance@company.com,demo-admin-key:admin:admin@company.com

# ── Optional (sensible defaults shown) ───────────────────────────────────────
DB_PATH=data/procurement.db
LOG_LEVEL=INFO
LLM_TEMPERATURE=0.1
# MAX_NEW_TOKENS=          # leave unset — defaults are per-provider
#                          # (reasoning models need far more than 512)
# OLLAMA_HOST=http://localhost:11434
CHAT_RATE_LIMIT=20              # max /chat requests per client per window
CHAT_RATE_WINDOW_SECONDS=60
